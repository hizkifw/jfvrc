# JFVRC configuration. Copy to .env and fill in real values.

# Required: token the operator UI uses to call the admin API.
# Use a long random value, e.g. `openssl rand -base64 32`.
ADMIN_TOKEN=change-me-to-a-long-random-value

# Required for playback: the Jellyfin server that JFVRC talks to.
# May include a web path prefix such as http://jellyfin:8096/jellyfin
# Do not include credentials, a query string, or a fragment.
JELLYFIN_URL=http://jellyfin:8096

# Required for playback: a Jellyfin API key (Dashboard -> API Keys).
JELLYFIN_API_KEY=replace-with-jellyfin-api-key

# Required for playback: the Jellyfin user whose library is exposed.
JELLYFIN_USER_ID=00000000-0000-0000-0000-000000000000

# Public base URL that players can reach. Must be the external HTTPS origin
# (reverse proxy) when deployed. Never derived from request headers.
# Example: https://jellyfin-links.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Persistent SQLite file. In Docker this lives on the /data volume.
DATABASE_PATH=/data/jfvrc.db

# Listen address.
HOST=0.0.0.0
PORT=3000

# Idle playback session TTL in seconds since the last request.
SESSION_IDLE_TTL_SECONDS=600

# Maximum active playback sessions plus pending negotiations across all links.
MAX_ACTIVE_SESSIONS=12

# Default and maximum link lifetime in hours (max must be <= 168 = 7 days).
LINK_DEFAULT_EXPIRY_HOURS=24
LINK_MAX_EXPIRY_HOURS=168

# Total API/playlist deadline; media header/body inactivity timeout in seconds.
UPSTREAM_TIMEOUT_SECONDS=30

# Group-viewing limits. Excess work receives 503; no unbounded waiting queue.
MAX_MEDIA_REQUESTS=512
MAX_UPSTREAM_TRANSFERS=8
MEDIA_REQUEST_TIMEOUT_SECONDS=120

# Shared segment buffers in MiB, including buffers pinned by slow viewers.
# Each new upstream media transfer reserves MAX_MEDIA_RESOURCE_MB.
MEDIA_CACHE_MB=128
MAX_MEDIA_RESOURCE_MB=16
MEDIA_CACHE_TTL_SECONDS=120

# Warm a newly created link in the background: negotiate the transcode and
# buffer the first segment while the operator copies the URL, so playback
# starts immediately. Set false to only negotiate on first player request.
PREWARM_LINKS=true

# Optional: log level (info, debug, warn, error).
LOG_LEVEL=info
