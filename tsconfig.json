{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "tests/server/**/*.ts",
    "tests/verification/**/*.ts"
  ]
}
